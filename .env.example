# Copy this file to .env, then paste YOUR OWN keys. .env is gitignored, never commit keys.

# Blitz API: sources your target list (TAM). Used by scripts/source_leads.py.
# Create a key (free credits to start): https://app.blitz-api.ai  ·  docs: https://docs.blitz-api.ai
BLITZAPI_API_KEY=

# lemlist: sends your multichannel campaign (LinkedIn + email). Used by scripts/push_to_lemlist.py.
# Create a key: lemlist -> Settings -> Integrations -> API  ·  docs: https://developer.lemlist.com
LEMLIST_API_KEY=

# --- Network enrichment (scripts/network_enrich.py). ONE of these is enough, all optional. ---
# The network import and filter work without any key. A key is only needed to verify
# the current job of the people on your shortlist.
# Blitz (the key above) is the default: --provider blitz
# HarvestAPI, live LinkedIn profile lookup: --provider harvest
# Create a key: https://harvest-api.com  ·  docs: https://docs.harvestapi.io
HARVEST_API_KEY=
# AI Ark, profile plus verified email: --provider aiark (API access needs a paid plan)
# docs: https://docs.ai-ark.com
AI_ARK_API_KEY=

# Optional, only if you want to verify emails yourself:
# KITT_API_KEY=
